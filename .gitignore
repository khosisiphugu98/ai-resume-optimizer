*.pdf
Resume.html
test_resumes/

# Cloudflare Wrangler local cache — contains account id/email, never commit
cf-worker/.wrangler/
node_modules/
# Wrangler secrets / local env — never commit
cf-worker/.dev.vars
.env
# Google OAuth client JSON downloads. The live copy belongs in apply-bot/profile/
# (already ignored); this catches the one that lands wherever the browser put it.
client_secret_*.json
*.apps.googleusercontent.com.json
apply-bot/node_modules/
apply-bot/artifacts/
apply-bot/data/
apply-bot/profile/
# Kill switch — a machine-local runtime flag. Committed, it would silently
# halt every run on a fresh clone.
apply-bot/STOP
